<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
>
    <!--
        `UpgradeCode` in MSI parlance is the unique ID of the application;
        `ProductCode` is the unique ID of a specific redistributable (autogenerated by WiX here).
        `Version` is the human-readable and machine-comparable identifier of a specific
        redistributable, but nothing in MSI enforces it to be unique.
    -->
    <?define UpgradeCode = "92081f48-e98d-427c-880d-0d560b8fb9c0" ?>
    <?define Version = "1.0.0" ?>

    <Package
        UpgradeCode="$(var.UpgradeCode)"
        Manufacturer="Glasgow Embedded Project"
        Name="Glasgow Interface Explorer"
        Version="$(var.Version)"
    >
        <!-- Embed cabinet file and compress it (in Release builds only) -->
        <?if "$(var.Configuration)" = "Release" ?>
            <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
        <?else?>
            <MediaTemplate EmbedCab="no" CompressionLevel="none"/>
        <?endif?>

        <!-- MSI bitness must match host -->
        <?if "$(var.Platform)" = "x64" ?>
            <Launch Condition="VersionNT64" Message="!(loc.x86VersionRequired)"/>
        <?endif?>
        <?if "$(var.Platform)" = "x86" ?>
            <Launch Condition="NOT VersionNT64" Message="!(loc.x64VersionRequired)"/>
        <?endif?>

        <!-- Windows 7 SP1 or later -->
        <Launch Condition="Installed OR VersionNT > 601 OR (VersionNT == 601 AND WindowsBuild >= 7100 AND ServicePackLevel >= 1)" Message="!(loc.OperatingSystemTooOld)"/>

        <!-- Uninstall other versions. https://docs.firegiant.com/wix/schema/wxs/majorupgrade/ -->
        <MajorUpgrade AllowDowngrades="yes"/>

        <!-- Branding -->
        <Icon Id="AppIcon" SourceFile="res\glasgow.ico"/>
        <Property Id="ARPPRODUCTICON" Value="AppIcon"/>

        <!-- Components -->
        <ComponentGroup Id="AppShortcuts">
            <ComponentRef Id="AppShortcuts"/>
        </ComponentGroup>

        <Feature Id="Main">
            <ComponentGroupRef Id="InstallFiles"/>
            <ComponentGroupRef Id="AppShortcuts"/>
        </Feature>

        <!-- Custom actions -->
        <CustomActionRef Id="InstallWheels"/>

        <!-- UI -->
        <ui:WixUI Id="WixUI_InstallDir_Custom" InstallDirectory="INSTALLFOLDER"/>
    </Package>
</Wix>
