<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
>
    <!--
        `UpgradeCode` in MSI parlance is the unique ID of the application;
        `ProductCode` is the unique ID of a specific redistributable (autogenerated by WiX here).
        `Version` is the human-readable and machine-comparable identifier of a specific
        redistributable, but nothing in MSI enforces it to be unique.
    -->
    <?define UpgradeCode = "7e62b400-07e1-4863-bead-bc9f6652c76d" ?>
    <?define AppVersion = "0.1" ?>
    <?define AppGitShort = "$(env.GLASGOW_GIT_SHORT)" ?>

    <Package
        UpgradeCode="$(var.UpgradeCode)"
        Manufacturer="!(loc.Manufacturer)"
        Name="!(loc.PackageName)"
        Version="$(var.AppVersion)"
        Codepage="UTF-8"
    >
        <!-- Embed cabinet file and compress it (in Release builds only) -->
        <?if "$(var.Configuration)" = "Release" ?>
            <!-- Cabinet files are compressed one at a time; lower MUMS means more threads -->
            <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="64"/>
        <?else?>
            <MediaTemplate EmbedCab="no" CompressionLevel="none"/>
        <?endif?>

        <!-- All checks are bypassable -->
        <Property Id="FORCEINSTALL" Value="0"/>

        <!-- MSI bitness must match host -->
        <?if "$(var.Platform)" = "x64" ?>
            <Launch Condition="Installed OR VersionNT64 OR (FORCEINSTALL > 0)" Message="!(loc.x86VersionRequired)"/>
        <?endif?>
        <?if "$(var.Platform)" = "x86" ?>
            <Launch Condition="Installed OR (NOT VersionNT64) OR (FORCEINSTALL > 0)" Message="!(loc.x64VersionRequired)"/>
        <?endif?>

        <!-- Windows 7 SP1 or later -->
        <Launch Condition="Installed OR (VersionNT > 601) OR ((VersionNT = 601) AND (WindowsBuild >= 7100) AND (ServicePackLevel >= 1)) OR (FORCEINSTALL > 0)" Message="!(loc.OperatingSystemTooOld)"/>

        <!-- Uninstall other versions. https://docs.firegiant.com/wix/schema/wxs/majorupgrade/ -->
        <MajorUpgrade AllowDowngrades="yes"/>

        <!-- Branding -->
        <Icon Id="AppIcon" SourceFile="res\glasgow.ico"/>
        <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
        <Property Id="FullVersion" Value="v$(var.AppVersion)+g$(var.AppGitShort)"/>

        <!-- Features -->
        <Feature Id="MainFeature">
            <ComponentGroupRef Id="InstallUCRT"/>
            <ComponentGroupRef Id="InstallApp"/>
            <ComponentGroupRef Id="InstallZadig"/>
            <ComponentGroupRef Id="Shortcuts"/>
        </Feature>

        <!-- Custom actions -->
        <CustomActionRef Id="InstallWheels"/>

        <!-- UI -->
        <ui:WixUI Id="WixUI_InstallDir_Custom" InstallDirectory="INSTALLFOLDER"/>
        <WixVariable Id="WixUIDialogBmp" Value="res/UIDialog.bmp"/>
        <WixVariable Id="WixUIBannerBmp" Value="res/UIBanner.bmp"/>
    </Package>
</Wix>
